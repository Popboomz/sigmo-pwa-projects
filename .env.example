# App
JWT_SECRET=change-me-in-production
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=0
QUESTION_ENGINE=template
# Optional bootstrap/migration fallback. Once adminUsers are managed in Firebase,
# you usually don't need to keep adding emails here.
ADMIN_EMAIL_ALLOWLIST=sigmapet@gmail.com

# Database
PGDATABASE_URL=postgres://user:password@localhost:5432/dbname
DATABASE_URL=postgres://user:password@localhost:5432/dbname

# Firebase (Client)
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# AI Engine (server-side only)
AI_PROVIDER=openai
AI_API_KEY=your_server_only_key
AI_MODEL=gpt-4o-mini
# OpenAI direct example:
# AI_API_BASE=https://api.openai.com/v1/chat/completions
# Google AI Studio / Gemini OpenAI-compatible example:
# AI_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/
# AI_MODEL=gemini-2.5-flash
AI_ADMIN_TOKEN=your_server_only_admin_token
